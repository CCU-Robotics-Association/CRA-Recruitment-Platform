# ============ CRA 面试平台 后端配置（server/.env） ============
# 复制本文件为 server/.env 并按需修改；所有变量均可选，未配置时使用安全默认值。

# 服务监听
CRA_PORT=3000
# CRA_HOST=0.0.0.0

# 数据目录（SQLite 数据库与自动生成的 JWT 密钥存放于此；默认 server/data）
# CRA_DATA_DIR=./data
# CRA_DB_FILE=cra.db

# JWT 密钥：生产环境请务必设置（至少 32 字符）；不设置时自动生成并持久化到数据目录
# CRA_JWT_SECRET=please-change-me-to-a-long-random-string
# CRA_JWT_EXPIRES_IN=43200

# 首次启动创建的默认管理员（仅在 users 表为空时生效）
CRA_ADMIN_USERNAME=admin
# 生产环境务必设置强密码！
# CRA_ADMIN_PASSWORD=
# CRA_ADMIN_DISPLAY_NAME=系统管理员

# 跨域来源（开发模式下报名端/管理端 vite dev server 直连后端时需要）：
# CRA_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 静态托管目录（默认取 ../dist/web、../dist/admin 与 ../dist/user；置空可禁用）
# CRA_WEB_DIST=../dist/web
# CRA_ADMIN_DIST=../dist/admin
# CRA_USER_DIST=../dist/user

# 开发模式（启用 pino-pretty 可读日志）
# CRA_DEV=1
# CRA_LOG_LEVEL=info
