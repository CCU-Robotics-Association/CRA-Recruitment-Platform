{
  "name": "cra-interview-platform-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRA 在线面试平台后端：报名 API + 管理 API + 管理端静态托管",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "npm --prefix admin-web install && npm --prefix user-web install",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:admin": "npm --prefix admin-web run build",
    "build:user": "npm --prefix user-web run build",
    "build": "npm run typecheck && npm run build:admin && npm run build:user"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.11.2",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.9.2"
  }
}
