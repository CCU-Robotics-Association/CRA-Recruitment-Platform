{
  "name": "cra-interview-platform-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRA 在线报名平台后端：报名 API + 管理 API + 管理端静态托管",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "npm --prefix admin-web ci",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "start:production": "node --env-file=.env.production src/index.ts",
    "preflight:production": "node --env-file=.env.production src/scripts/preflight.ts",
    "backup": "node --env-file-if-exists=.env src/scripts/backup.ts",
    "restore:verify": "node --env-file-if-exists=.env src/scripts/restoreVerify.ts",
    "healthcheck": "node --env-file-if-exists=.env src/scripts/healthcheck.ts",
    "test": "node --test test/backend.test.ts",
    "test:load": "node --test test/load.test.ts",
    "typecheck": "tsc --noEmit",
    "build:admin": "npm --prefix admin-web run build",
    "build": "npm run typecheck && npm run build:admin"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.11.2",
    "nodemailer": "^9.0.5",
    "pino": "^9.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.9.2"
  }
}
