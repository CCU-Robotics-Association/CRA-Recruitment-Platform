[Unit]
Description=Check CRA Recruitment readiness

[Service]
Type=oneshot
User=cra-recruitment
Group=cra-recruitment
WorkingDirectory=/opt/cra-recruitment/server
EnvironmentFile=/opt/cra-recruitment/server/.env.production
ExecStart=/usr/bin/npm run healthcheck
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
